# Generate a private .env with: make init-local
COT_ENV=local
COT_AUTH_MODE=dev-token
COT_DEV_PLAYER_ID=local-player
COT_DEV_AUTH_TOKEN=replace-with-a-generated-token-at-least-32-characters
COT_DB_PORT=55432
COT_POSTGRES_PASSWORD=replace-with-a-generated-database-password
COT_DATABASE_URL=postgres://cot:replace-with-a-generated-database-password@127.0.0.1:55432/cot?sslmode=disable
COT_DB_MAX_CONNECTIONS=4
COT_LOG_LEVEL=info
# COT_HTTP_ADDR defaults to 127.0.0.1:8080 for game and :8081 for trading.
# Non-loopback binding additionally requires COT_ALLOW_LAN=true.
